{
  "description": "plan-ledger：规划门禁、进度台账与三方一致性核对。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/pre-tool.mjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "plan-ledger：检查本轮是否已规划…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TodoRead",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/post-tool.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
