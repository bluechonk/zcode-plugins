{
  "description": "pua-bridge：把 PUA 的 Claude Code 命令钩子接进 ZCode。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "PUA：恢复会话上下文…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "PUA：识别触发词…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "PUA：完整性守卫…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "PUA：失败检测…"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "PUA：收尾核对…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pua-bridge.mjs"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
